{
  "name": "@hanzo/zap",
  "version": "0.2.1",
  "description": "ZAP - Zero-Copy App Proto for TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "keywords": [
    "capnproto",
    "rpc",
    "agents",
    "mcp",
    "ai",
    "hanzo"
  ],
  "author": "Hanzo AI <dev@hanzo.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/zap"
  },
  "homepage": "https://hanzo.ai/zap",
  "bugs": {
    "url": "https://github.com/hanzoai/zap/issues"
  },
  "dependencies": {
    "capnp-ts": "^0.9.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
